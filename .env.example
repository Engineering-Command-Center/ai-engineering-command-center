# ─── App ───────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Qdrant ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=  # only needed if Qdrant is deployed with auth

# ─── Embedding & Knowledge Base ────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50
KNOWLEDGE_COLLECTION=engineering_knowledge
CHUNK_MAX_CHARS=4000
CHUNK_OVERLAP_CHARS=200

# ─── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SECRET_KEY=your-random-secret-key-min-32-chars
ALLOWED_EMAIL_DOMAIN=yourdomain.com
FRONTEND_URL=http://localhost:3000

# ─── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_ORG=your_github_org_name

# ─── Repository Scanner ────────────────────────────────────
# Filtering is applied in three layers (all three must pass):
#
#   GITHUB_REPO_PREFIX     — startswith check (fastest, applied first)
#                            Unset = no prefix restriction.
#
#   REPO_INCLUDE_PATTERNS  — comma-separated glob list; repo must match ≥1 pattern
#                            Default "*" matches everything.
#
#   REPO_EXCLUDE_PATTERNS  — comma-separated glob list; any match rejects the repo
#
# Scan a specific product team's repos only:
#   GITHUB_REPO_PREFIX=cinema-
#   REPO_INCLUDE_PATTERNS=cinema-*
#   REPO_EXCLUDE_PATTERNS=experimental-*,poc-*,cinema-legacy-*
#
# Scan everything except experimental repos:
#   REPO_INCLUDE_PATTERNS=*
#   REPO_EXCLUDE_PATTERNS=experimental-*,poc-*

# GITHUB_REPO_PREFIX=                       # e.g. cinema-  (leave unset for no restriction)
# Local path where repos are cloned. Use an absolute path.
# On macOS: /Users/<you>/repos  |  On Linux: /home/<you>/repos  |  On server: /data/repos
REPOS_BASE_PATH=/Users/your-username/repos
REPO_INCLUDE_PATTERNS=["*"]
REPO_EXCLUDE_PATTERNS=["experimental-*","poc-*"]
REPO_SYNC_CONCURRENCY=4

# ─── AWS ───────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ─── Frontend (Next.js public vars) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]
